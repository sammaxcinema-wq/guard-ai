{
  "entities": {
    "User": {
      "title": "User",
      "description": "A business owner using the POS system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "name": { "type": "string", "description": "The user's name." },
        "phone": { "type": "string", "description": "The user's phone number." },
        "businessName": { "type": "string", "description": "The name of the business." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user signed up." }
      },
      "required": ["uid", "name", "businessName"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A recorded transaction.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who made the sale." },
        "customerId": { "type": "string", "description": "The ID of the customer (optional)." },
        "amount": { "type": "number", "description": "The total amount of the sale." },
        "paymentMethod": { "type": "string", "enum": ["cash", "mpesa"], "description": "How the sale was paid for." },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "date": { "type": "string", "format": "date-time", "description": "When the sale occurred." }
      },
      "required": ["userId", "amount", "paymentMethod", "date"]
    },
    "Product": {
      "title": "Product",
      "description": "An item in the inventory.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who owns the product." },
        "name": { "type": "string", "description": "The name of the product." },
        "stockQuantity": { "type": "number", "description": "Current stock level." },
        "buyingPrice": { "type": "number", "description": "Cost to the business." },
        "sellingPrice": { "type": "number", "description": "Price to the customer." },
        "lowStockThreshold": { "type": "number", "description": "Threshold for low stock alerts." }
      },
      "required": ["userId", "name", "stockQuantity", "buyingPrice", "sellingPrice"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A customer of the business.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the business owner." },
        "name": { "type": "string", "description": "The customer's name." },
        "phone": { "type": "string", "description": "The customer's phone number." },
        "email": { "type": "string", "description": "The customer's email address." },
        "address": { "type": "string", "description": "The customer's address." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the customer was added." }
      },
      "required": ["userId", "name"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A business expense.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who recorded the expense." },
        "title": { "type": "string", "description": "What the expense was for." },
        "amount": { "type": "number", "description": "The cost of the expense." },
        "date": { "type": "string", "format": "date-time", "description": "When the expense occurred." }
      },
      "required": ["userId", "title", "amount", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Recorded sales transactions."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Inventory items."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer information."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business expenses."
    }
  }
}
